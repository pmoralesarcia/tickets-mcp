# --- MySQL de osTicket (usuario de solo lectura, ver sql/mysql_usuario_solo_lectura.sql) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=bd_osticket
MYSQL_USER=mcp_tickets
MYSQL_PASSWORD=
MYSQL_POOL_MAX=2
MYSQL_QUERY_TIMEOUT_MS=20000

# --- Servidor MCP ---
HOST=127.0.0.1
PORT=8767
# Clave que la pasarela envía como "Authorization: Bearer". Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=
# Lista blanca de Origin (separados por comas). Vacía = no se valida.
ALLOWED_ORIGINS=
CHARACTER_LIMIT=100000
LOG_FILE=/var/log/tickets-mcp/mcp-tickets.log
