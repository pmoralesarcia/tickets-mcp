[Unit]
Description=tickets-mcp (MCP de solo lectura sobre la BBDD de osTicket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# CAMBIAR estos dos valores por el usuario y la ruta reales en el servidor:
User=valmesa
WorkingDirectory=/home/valmesa/tickets-mcp
EnvironmentFile=/home/valmesa/tickets-mcp/.env
ExecStart=/usr/bin/node /home/valmesa/tickets-mcp/src/index.js
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
# El log de auditoría va a /var/log/tickets-mcp (LOG_FILE en .env)
LogsDirectory=tickets-mcp
# Hardening basico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
